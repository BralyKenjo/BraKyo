-- ============ TIME & FILE HELPERS ============
local function normalize(s) return (s or ""):gsub("%s+", "") end

local function GetVNTimeString()
    return os.date("%d/%m/%Y", os.time() + (7 * 3600))
end

local function LoadSavedKey()
    if not (isfile and readfile) then return nil end
    if not isfile(KEY_FILE) then return nil end
    local ok, content = pcall(readfile, KEY_FILE)
    if not ok or not content then return nil end
    local key, savedDate = content:match("^(.-)|(.*)$")
    if key and savedDate then
        if savedDate == GetVNTimeString() then
            return normalize(key)
        else
            pcall(function() delfile(KEY_FILE) end)
            return nil
        end
    end
    return nil
end

local function SaveKeyFile(key)
    if writefile then 
        pcall(function() writefile(KEY_FILE, key .. "|" .. GetVNTimeString()) end) 
    end
end

local function CheckIsUsed(key)
    if not (isfile and readfile) then return false end
    if not isfile(USED_KEYS_FILE) then return false end
    local ok, content = pcall(readfile, USED_KEYS_FILE)
    if ok and content then
        for line in content:gmatch("[^\r\n]+") do
            if line == key then return true end
        end
    end
    return false
end

local function MarkKeyAsUsed(key)
    if appendfile then
        pcall(function() appendfile(USED_KEYS_FILE, key .. "\n") end)
    elseif writefile and readfile and isfile then
        local content = ""
        if isfile(USED_KEYS_FILE) then content = readfile(USED_KEYS_FILE) end
        pcall(function() writefile(USED_KEYS_FILE, content .. key .. "\n") end)
    end
end

local function IsValidKey(input)
    local normalizedInput = normalize(input)
    for _, k in ipairs(VALID_KEYS) do
        if normalize(k) == normalizedInput then
            return true
        end
    end
    return false
end

