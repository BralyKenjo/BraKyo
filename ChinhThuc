            TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(24, 28, 42)}):Play()
        end)
        Card.MouseLeave:Connect(function()
            TweenService:Create(CardStroke, TweenInfo.new(0.15), {Color = THEME.Border}):Play()
            TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundColor3 = THEME.Card}):Play()
        end)

        -- Xử lý Copy & Load
        CopyBtn.MouseButton1Click:Connect(function()
            if setclipboard then setclipboard("loadstring(game:HttpGet(\"" .. url .. "\"))()") end
            CopyBtn.Text = "✅"
            task.wait(1)
            CopyBtn.Text = "📋"
        end)

        CodeBtn.MouseButton1Click:Connect(function()
            CodeLabel.Text = "⏳ Đang tải..."
            task.spawn(function()
                local success, err = pcall(function()
                    loadstring(game:HttpGet(url))()
                end)
                if success then
                    CodeLabel.Text = "✅ Thành công!"
                    CodeLabel.TextColor3 = THEME.Ok
                else
                    CodeLabel.Text = "❌ Lỗi tải"
                    CodeLabel.TextColor3 = THEME.Danger
                end
                task.wait(2)
                CodeLabel.Text = "loadstring(game:HttpGet(\"" .. url .. "\"))()"
                CodeLabel.TextColor3 = THEME.Muted
            end)
        end)
    end

    -- Tải & Hiển thị JSON
    local function LoadScriptList()
        local ok, response = pcall(function() return game:HttpGet(SCRIPT_LIST_URL) end)
        if not ok or not response then return end
        local decOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
        if not decOk or type(decoded) ~= "table" then return end

        local mappings = {
            ["Steal an egg"] = { Icon = "🥚", Tags = {"Hub", "Auto"} },
            ["Blox Fruit"]   = { Icon = "🍇", Tags = {"Hub", "Farm"} },
        }

        -- Xóa thẻ cũ nếu có
        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local layoutOrder = 0
        for keyName, config in pairs(mappings) do
            local items = decoded[keyName]
            if items and #items > 0 then
                for _, item in ipairs(items) do
                    layoutOrder = layoutOrder + 1
                    local card = Instance.new("Frame")
                    card.LayoutOrder = layoutOrder
                    card.Parent = Scroll
                    CreateScriptCard(card, item.Name, item.Url, "Script " .. item.Name, config.Icon, config.Tags)
                end
            end
        end
    end

    -- Search Filter
    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(SearchBox.Text)
        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("Frame") then
                local titleLabel = child:FindFirstChild("TextLabel")
                if titleLabel then
                    local name = string.lower(titleLabel.Text)
                    child.Visible = (q == "") or (name:find(q, 1, true) ~= nil)
                end
            end
        end
    end)

    -- DRAG
    do
        local dragging, dragStart, startPos
        local function beginDrag(input)
            dragging = true; dragStart = input.Position; startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then beginDrag(input) end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- Khởi chạy tải JSON
    task.spawn(LoadScriptList)

    -- Hiệu ứng mở
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, BASE_WIDTH, 0, BASE_HEIGHT),
        Position = UDim2.new(0.5, -BASE_WIDTH/2, 0.5, -BASE_HEIGHT/2),
    }):Play()
end

