-- Dragging logic
local dragging = false
local dragStart = Vector2.zero
local startPos = UDim2.new()

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = MainCard.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        MainCard.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local isLoading = false

local function LoadMainScript()
    local source = game:HttpGet(CONFIG.ScriptUrl)
    local loader = loadstring(source)
    if type(loader) == "function" then
        loader()
        return true
    end
    return false
end

GetKeyBtn.MouseButton1Click:Connect(function()
    local randomLink, idx, total = GetRandomKeyLink()
    if randomLink ~= "" then
        PulseDynamicIsland("COPIED #" .. tostring(idx), C.Blue, 95)
        if type(setclipboard) == "function" then
            setclipboard(randomLink)
            StatusLabel.Text = "Copied link #" .. tostring(idx) .. " of " .. tostring(total) .. "!"
            StatusLabel.TextColor3 = C.Blue
        else
            StatusLabel.Text = randomLink
            StatusLabel.TextColor3 = C.Blue
        end
    else
        PulseDynamicIsland("NO LINK", C.Red, 82)
        StatusLabel.Text = "No Get Key link configured!"
        StatusLabel.TextColor3 = C.Red
    end
end)

VerifyBtn.MouseButton1Click:Connect(function()
    if isLoading then return end
    local entered = KeyInput.Text
    if IsValidKey(entered) then
        isLoading = true
        PulseDynamicIsland("VERIFIED", C.White, 92)
        StatusLabel.Text = "Key accepted. Loading hub..."
        StatusLabel.TextColor3 = C.Blue
        VerifyBtn.Text = "LOADING..."
        task.wait(0.4)
        local ok, err = pcall(LoadMainScript)
        if ok then
            ScreenGui:Destroy()
        else
            isLoading = false
            VerifyBtn.Text = "VERIFY  ->"
            StatusLabel.Text = "Load error: " .. tostring(err)
            StatusLabel.TextColor3 = C.Red
        end
    else
        PulseDynamicIsland("INVALID", C.Red, 85)
        StatusLabel.Text = "Invalid key. Please try again."
        StatusLabel.TextColor3 = C.Red
        InputStroke.Color = C.Red
        task.delay(0.8, function()
            if InputStroke and InputStroke.Parent then
                InputStroke.Color = C.CardLine
            end
        end)
    end
end)
