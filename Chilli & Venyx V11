local function AddButtonMotion(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.13), {
            BackgroundColor3 = hoverColor
        }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.13), {
            BackgroundColor3 = normalColor
        }):Play()
    end)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset, 1, -4)
        }):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.09, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset, 1, 0)
        }):Play()
    end)
end

