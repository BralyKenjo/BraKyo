-- ============ 2. TỐI ƯU TỪ ĐIỂN (Tránh dịch đè) ============
-- Sắp xếp các từ khóa dài hơn lên đầu để dịch trước
local SortedKeys = {}
for k, v in pairs(Translations) do
    table.insert(SortedKeys, {en = k, vi = v})
end
table.sort(SortedKeys, function(a, b) 
    return #a.en > #b.en 
end)

-- ============ 3. CÀI ĐẶT HOOK DỊCH THUẬT (Có chống Crash) ============
local hookSuccess = pcall(function()
    local OldNewIndex
    OldNewIndex = hookmetamethod(game, "__newindex", function(self, key, value)
        if not checkcaller() and type(value) == "string" then
            if (key == "Text" or key == "PlaceholderText") and (self:IsA("TextLabel") or self:IsA("TextButton") or self:IsA("TextBox")) then
                -- Dịch chính xác từng từ
                if Translations[value] then
                    value = Translations[value]
                else
                    -- Dịch chuỗi con (Dùng mảng đã sắp xếp để tránh lỗi)
                    for _, dict in ipairs(SortedKeys) do
                        if string.find(value, dict.en, 1, true) then
                            value = string.gsub(value, dict.en, dict.vi)
                        end
                    end
                end
            end
        end
        return OldNewIndex(self, key, value)
    end)
end)

if hookSuccess then
    print("[TRANSLATOR] Đã kích hoạt bộ dịch tiếng Việt!")
else
    warn("[TRANSLATOR] Executor không hỗ trợ hookmetamethod, sẽ tải script không có bản dịch.")
end

-- ============ 4. TẢI SCRIPT BRAKYO GỐC ============
task.wait(0.2) -- Đợi hook ổn định

